+        result = run([sys.executable, "-m", "pytest", "-q", *args], env=clean_env(), capture=True)
+        assert " skipped" not in result.stdout
+        assert "tests/smoke/" not in result.stdout
+        print(result.stdout.splitlines()[-1], flush=True)
